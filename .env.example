# Google Apps Script Web App URL from backend/order-store/SETUP.md
NEXT_PUBLIC_BACKEND_URL=

# Razorpay API keys. Keep the secret server-side; never use NEXT_PUBLIC_ here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Private inventory portal (server-only; do not prefix these with NEXT_PUBLIC_)
INVENTORY_ADMIN_USERNAME=
INVENTORY_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Must also be set in Google Apps Script > Project Settings > Script properties
SHEETS_ADMIN_TOKEN=
