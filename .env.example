# Optional persistent CSV location. Defaults to this repository's data/ folder.
# For production, point this at a durable writable folder outside deploy checkouts.
MK_DATA_DIR=

# Optional durable menu-image folder. Defaults to public/uploads/menu/.
MK_UPLOAD_DIR=

# Razorpay. Keep the secret server-side; never prefix these with NEXT_PUBLIC_.
# Leave both blank until you are ready to take online payments.
# Cash on delivery does not use these keys.
# After you paste the values, restart the site, then turn Razorpay on
# under Payments in the private inventory admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Private inventory portal (server-only; do not prefix these with NEXT_PUBLIC_)
INVENTORY_ADMIN_USERNAME=
INVENTORY_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
